{
  "schema_version": "1.0",
  "dataset_id": "loading_particle_type",
  "title": "Particle type and loading",
  "factor": {
    "name": "Particle type / loading",
    "symbol": null,
    "units": null,
    "description": "Four suspensions compared: plain silica at two loadings, ordered mesoporous SBA-15, and mesoporous silica nanoparticles (MSN). Pore architecture and loading are varied together, so the two effects are not separable here.",
    "effect": "Ordered mesoporous SBA-15 gives the lowest normalized K, about 6.7x below plain silica at 1 mg/mL."
  },
  "source": {
    "citation": "L. Spitzmüller et al., J. Nanopart. Res. 25 (2023) 40",
    "figure": "Fig. 4b",
    "reference_label": "Chunk 2",
    "doi": "10.1007/s11051-023-05688-4",
    "digitized": true,
    "note": "Points digitized from the published figure. Each series normalized to its own plateau. Two series show a genuine plateau below full dissolution: 1 mg/mL at 0.886 and 0.2 mg/mL SBA-15 at 0.931."
  },
  "conditions": {
    "medium": "aqueous",
    "temperature_C": 25,
    "pH": null,
    "assay": "dissolved silica, mg/L, normalized to the measured plateau",
    "time_units": "h",
    "hydrodynamics": "stirred"
  },
  "axes": {
    "x": {
      "label": "Time",
      "units": "h"
    },
    "y": {
      "label": "Remaining Si fraction",
      "units": "-",
      "min": 0,
      "max": 1
    }
  },
  "models": [
    {
      "id": "walls",
      "name": "Cellular walls",
      "morphology": "thin walls between pores",
      "sigma": "2*sqrt(p) - p",
      "param": {
        "name": "K",
        "units": "1/h"
      },
      "formula_latex": "F(t)=\\frac{1}{1-p_0}\\left[1-\\frac{4}{\\left(1+W_0\\!\\left(y_0e^{y_0-2Kt}\\right)\\right)^2}\\right],\\quad y_0=\\frac{2}{\\sqrt{p_0}}-1",
      "formula_plain": "F = [1 − 4/(1+W₀(y₀·e^(y₀−2Kt)))²] / (1−p₀),   y₀ = 2/√p₀ − 1",
      "formula_js": "y0=2/Math.sqrt(p0)-1; y=lambertW0(y0*Math.exp(y0-2*K*t)); F=(1-4/Math.pow(1+y,2))/(1-p0)",
      "needs": [
        "lambertW0"
      ],
      "t_final": "(y0 + ln(y0) - 1)/(2K)"
    },
    {
      "id": "wires",
      "name": "Nanowires",
      "morphology": "cylindrical skeleton",
      "sigma": "sqrt(p*(1-p))",
      "param": {
        "name": "K",
        "units": "1/h"
      },
      "formula_latex": "F(t)=\\frac{1}{1-p_0}\\frac{u^2}{1+u^2},\\quad u=\\sqrt{\\frac{1-p_0}{p_0}}-\\frac{Kt}{2}",
      "formula_plain": "F = [u²/(1+u²)] / (1−p₀),   u = √((1−p₀)/p₀) − Kt/2",
      "formula_js": "u=Math.max(Math.sqrt((1-p0)/p0)-K*t/2,0); F=(u*u/(1+u*u))/(1-p0)",
      "needs": [],
      "t_final": "2*sqrt((1-p0)/p0)/K"
    },
    {
      "id": "dots",
      "name": "Nanodots",
      "morphology": "spherical residual nodes",
      "sigma": "p^(1/3)*(1-p)^(2/3)",
      "param": {
        "name": "K",
        "units": "1/h"
      },
      "formula_latex": "F(t)=\\frac{1}{1-p_0}\\frac{v^3}{1+v^3},\\quad v=\\left(\\frac{1-p_0}{p_0}\\right)^{1/3}-\\frac{Kt}{3}",
      "formula_plain": "F = [v³/(1+v³)] / (1−p₀),   v = ((1−p₀)/p₀)^(1/3) − Kt/3",
      "formula_js": "v=Math.max(Math.cbrt((1-p0)/p0)-K*t/3,0); F=(v*v*v/(1+v*v*v))/(1-p0)",
      "needs": [],
      "t_final": "3*cbrt((1-p0)/p0)/K"
    },
    {
      "id": "fragmentation",
      "name": "Fragmentation",
      "morphology": "skeleton breaking into fragments",
      "sigma": "sqrt(p)*(1-sqrt(p))",
      "param": {
        "name": "K",
        "units": "1/h"
      },
      "formula_latex": "F(t)=\\frac{1-w^2}{1-p_0},\\quad w=\\frac{1}{1+W_0\\!\\left(e^{-C-1}\\right)},\\quad C=\\ln\\frac{\\sqrt{p_0}}{1-\\sqrt{p_0}}-\\frac{1}{\\sqrt{p_0}}+\\frac{Kt}{2}",
      "formula_plain": "F = (1−w²)/(1−p₀),   w = 1/(1+W₀(e^(−C−1))),   C = ln(√p₀/(1−√p₀)) − 1/√p₀ + Kt/2",
      "formula_js": "C=Math.log(Math.sqrt(p0)/(1-Math.sqrt(p0)))-1/Math.sqrt(p0)+K*t/2; w=1/(1+lambertW0(Math.exp(-C-1))); F=(1-w*w)/(1-p0)",
      "needs": [
        "lambertW0"
      ],
      "t_final": null
    },
    {
      "id": "slow_diffusion",
      "name": "Slow diffusion",
      "morphology": "shrinking particle, porosity constant",
      "sigma": null,
      "param": {
        "name": "t_f",
        "units": "h"
      },
      "formula_latex": "F(t)=u^3,\\quad u=\\tfrac{1}{2}+\\cos\\!\\left(\\frac{2\\pi-\\arccos\\!\\left(2t/t_f-1\\right)}{3}\\right)",
      "formula_plain": "F = u³,   u = ½ + cos[(2π − arccos(2t/t_f − 1))/3]",
      "formula_js": "x=Math.min(Math.max(2*t/tf-1,-1),1); u=0.5+Math.cos((2*Math.PI-Math.acos(x))/3); F=(t>=tf)?0:u*u*u",
      "needs": [],
      "t_final": "t_f",
      "note": "Does not use p0. Diffusion-limited regime, single parameter."
    }
  ],
